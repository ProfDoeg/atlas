    {
      "name": "The electric telegraph",
      "ntype": "agent",
      "lat": null,
      "lng": null,
      "born": 1844,
      "died": null,
      "born_confidence": "attested",
      "died_confidence": "unattested",
      "region": "France",
      "note": "The successor that did not require daylight, a visible chain, or a staffed tower every ten kilometres. Optical and electric service coexisted for years before the state converted line by line between 1847 and 1853.",

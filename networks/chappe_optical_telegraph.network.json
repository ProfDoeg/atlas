    {
      "name": "The stationnaires",
      "ntype": "agent",
      "lat": null,
      "lng": null,
      "born": 1794,
      "died": 1854,
      "born_confidence": "approximate",
      "died_confidence": "approximate",
      "region": "France",
      "note": "The relay workforce: pairs of operators at every intermediate post who reproduced a visible shape without knowing its meaning. Poorly paid, sometimes owed wages for months, their compartmentalized ignorance protected the code but not the syntax, which is exactly what the Blanc affair exploited.",
      "sources": [
        "https://cnum.cnam.fr/pgi/redir.php?ident=8VI101&onglet=c",
        "https://www.fnarh.com/files/Fiche_pedagogique_edition_2010.pdf"

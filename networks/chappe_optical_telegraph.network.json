    {
      "name": "Administration des lignes télégraphiques",
      "ntype": "agent",
      "lat": null,
      "lng": null,
      "born": 1793,
      "died": 1854,
      "born_confidence": "attested",
      "died_confidence": "approximate",
      "region": "France",
      "note": "The state itself as operator: the Convention's Committee of Public Safety, then War, Navy, and Interior ministries in turn, then royal and imperial administrations, financing lines, controlling terminals, and after 1837 holding a criminal monopoly on long-distance signaling.",
      "sources": [
        "https://iredic.fr/wp-content/uploads/2019/07/deicret-4-avril-1793-en-page.pdf",
        "https://iredic.fr/wp-content/uploads/2019/07/loi-de-1837.pdf",

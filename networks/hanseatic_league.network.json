        "https://www.historische-kommission.niedersachsen.de/download/191350/Jb_92_2020.pdf"
      ]
    },
    {
      "name": "Jürgen Wullenwever",
      "ntype": "agent",
      "lat": 53.8655,
      "lng": 10.6866,
      "born": 1533,
      "born_confidence": "approximate",
      "died": 1537,
      "died_confidence": "attested",
      "region": "Lübeck",
      "note": "Mayor of Lübeck who tried to restore its regional position by intervening in Denmark's Count's Feud and challenging Dutch access to the Baltic. Captured by forces of the Archbishop of Bremen after his defeat, he was tortured and executed in 1537.",
      "sources": [
        "https://www.historische-kommission.niedersachsen.de/download/191350/Jb_92_2020.pdf"
      ]
    },
    {
      "name": "Heinrich Sudermann",
      "ntype": "agent",
      "lat": 50.9375,
      "lng": 6.9603,
      "born": 1556,
      "born_confidence": "attested",
      "died": 1591,
      "died_confidence": "approximate",
      "region": "Cologne, and an itinerant Hanseatic syndic",
      "note": "Cologne jurist appointed the Hanse's first permanent syndic in 1556, providing continuity in diplomacy, records, and legal argument as attendance grew irregular. His office did not turn the Hanse into a centralized bureaucracy.",
      "sources": [
        "https://compass.onlinelibrary.wiley.com/doi/full/10.1111/hic3.12798"
      ]
    },
    {
      "name": "The Vitalienbrüder",
      "ntype": "agent",
      "lat": null,
      "lng": null,
      "born": 1389,
      "born_confidence": "attested",
      "died": 1436,
      "died_confidence": "attested",
      "region": "North Sea and Baltic",
      "note": "Shifting armed groups, sometimes fighting for Lübeck and other patrons, later generalized into a single 'brotherhood' they never constitutionally were. The Klaus Störtebeker legend is a small documented core surrounded by later legend; a Störtebeker name remains documented into the 1430s.",
      "sources": [
        "https://www.hansemuseum.eu/records/was-waren-die-vitalienbrueder/",
